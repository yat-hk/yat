{
  "yat": 1,
  "id": "test-compute-mini",
  "name": {
    "en": "compute engine test (internal)"
  },
  "description": {
    "en": "Purpose-built pack exercising top-level compute (§7.4): single-placeholder numeric typing vs. surrounding-text string typing, evaluated against a pinned --now. Not a real content pack."
  },
  "aliases": {
    "en": [
      "compute engine test"
    ],
    "zh-Hant": [],
    "jyutping": []
  },
  "params": {
    "type": "object",
    "properties": {
      "exam_date": {
        "type": "string",
        "format": "date",
        "title": "Exam date",
        "default": "2026-08-10"
      }
    },
    "required": [
      "exam_date"
    ],
    "additionalProperties": false
  },
  "data": {
    "sources": []
  },
  "compute": {
    "days_left": "{{params.exam_date|date_diff_days}}",
    "label": "T-minus {{params.exam_date|date_diff_days}} days"
  },
  "render": {
    "chrome": "standard",
    "widgets": [
      {
        "type": "column",
        "flex": 1,
        "padding": [
          16,
          24,
          16,
          24
        ],
        "gap": 4,
        "children": [
          {
            "type": "bignum",
            "value": "{{data.days_left}}",
            "size": "xlarge"
          },
          {
            "type": "text",
            "value": "{{data.label}}",
            "size": "medium"
          },
          {
            "type": "text",
            "value": "exam is in the future",
            "size": "small",
            "when": "data.days_left >= '0'"
          }
        ]
      }
    ]
  },
  "schedule": {
    "default": {
      "every_min": 1440
    }
  }
}