#pragma once
// copy to secrets.h and fill in your own values — secrets.h is gitignored.
//
// v0.1 compiled credentials in. From v0.3, WiFi credentials live in NVS
// (Preferences "yat", keys wifi_ssid/wifi_pass) and normally get there via
// provisioning: the WiFiManager QR captive portal, or Improv-serial over
// WebSerial/USB (ARCHITECTURE.md §8). This file is now only a *dev
// convenience*: on first boot, if NVS has no credentials yet and these are
// not the placeholder values below, they're copied into NVS once so
// `cp secrets.h.example secrets.h` + edit still "just works" without a
// provisioning round trip — after that NVS is authoritative and this file is
// never read again. To pick up a changed secrets.h later, erase NVS (hold
// KEY0 5s to re-enter provisioning, then use the portal/Improv instead, or
// erase flash) rather than editing this file a second time.

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"
